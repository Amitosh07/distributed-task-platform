# Copy to .env for local development. Never commit a real .env file.
DATABASE_URL=postgresql+psycopg://user:change-me@localhost:5432/workflow_platform
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ENVIRONMENT=development
REDIS_URL=redis://localhost:6379/0

# Phase 4 Configuration (optional overrides)
# HEARTBEAT_INTERVAL_SECONDS=2.0
# WORKER_STALE_THRESHOLD_SECONDS=10.0
# TASK_LEASE_SECONDS=10.0
# TASK_LEASE_RENEW_INTERVAL_SECONDS=3.0
# RECOVERY_INTERVAL_SECONDS=5.0
# DEFAULT_TASK_TIMEOUT_SECONDS=300
# DEFAULT_MAX_RETRIES=3
# RETRY_BACKOFF_BASE_SECONDS=1.0
# RETRY_BACKOFF_MAX_SECONDS=60.0

