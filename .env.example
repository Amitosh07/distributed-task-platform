# ===========================================================================
# Distributed Task Platform — Environment Configuration Template
# ===========================================================================

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=workflow_platform

# FastAPI & Worker Database URLs (Used when running inside Docker Compose)
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/workflow_platform
REDIS_URL=redis://redis:6379/0

# Security & Authentication
# IMPORTANT: Replace with a secure random key (>= 32 characters) for production
JWT_SECRET_KEY=development-secret-key-that-is-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application Environment
ENVIRONMENT=development

# Frontend Configuration (Browser-facing URL to access the API)
VITE_API_BASE_URL=http://localhost:8000

# OpenTelemetry Tracing Endpoint (Collector inside Docker Compose)
OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317

# Grafana Administration Credentials
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Worker Reliability Tuning (Optional Overrides)
TASK_LEASE_SECONDS=10.0
HEARTBEAT_INTERVAL_SECONDS=2.0
RECOVERY_INTERVAL_SECONDS=5.0
WORKER_STALE_THRESHOLD_SECONDS=10.0
